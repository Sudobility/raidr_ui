{
  "name": "@sudobility/raidr_ui",
  "version": "0.0.4",
  "description": "Shared presentational UI for the raidr catalog console (raidr_app + raidr_mcp_app)",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/fix-esm-imports.mjs",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "typecheck": "tsc --noEmit",
    "dev": "npm run build:watch"
  },
  "peerDependencies": {
    "@sudobility/components": "^5.3.78",
    "@sudobility/design": "^1.1.72",
    "@sudobility/raidr_lib": "^0.1.38",
    "@sudobility/raidr_types": "^0.1.26",
    "@xyflow/react": ">=12.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "react-i18next": ">=15.0.0",
    "react-markdown": ">=9.0.0",
    "remark-gfm": ">=4.0.0",
    "@sudobility/types": "^1.11.2"
  },
  "devDependencies": {
    "@sudobility/components": "^5.3.78",
    "@sudobility/design": "^1.1.72",
    "@sudobility/raidr_lib": "^0.1.38",
    "@sudobility/raidr_types": "^0.1.26",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@xyflow/react": "~12.12.0",
    "class-variance-authority": "~0.7.1",
    "i18next": "~26.3.1",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "react-i18next": "~17.0.8",
    "react-markdown": "~10.1.0",
    "remark-gfm": "~4.0.1",
    "typescript": "~6.0.3"
  },
  "author": "Sudobility team",
  "license": "BUSL-1.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sudobility/raidr_ui.git"
  }
}
